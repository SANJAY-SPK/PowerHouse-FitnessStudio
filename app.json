{
  "expo": {
    "name": "Power House",
    "slug": "PowerHouseFitnessStudio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/App_Logo.jpeg",
    "scheme": "powerhousefitnessstudio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/App_Logo.jpeg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15173D",
        "foregroundImage": "./assets/images/App_Logo.jpeg",
        "backgroundImage": "",
        "monochromeImage": ""
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.opzeus.PowerHouseFitnessStudio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/App_Logo.jpeg"
    },
    "backgroundColor": "#FFFFFF",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15173D",
          "android": {
            "image": "./assets/images/App_Logo.jpeg",
            "imageWidth": 200
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "225f7ca6-734f-414c-9fdd-3b267e738e1d"
      }
    }
  }
}
